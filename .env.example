# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID — the only user this bot will respond to.
# Get it by messaging @userinfobot on Telegram.
AUTHORIZED_USER_ID=

# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to summarizer.db in the project root.
DB_PATH=
