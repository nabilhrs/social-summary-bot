# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use this bot, e.g.
# AUTHORIZED_USER_IDS=111111111,222222222
# List yourself first — on first run after upgrading, any pre-existing
# saved items get assigned to whichever ID is listed first here.
# Get an ID by messaging @userinfobot on Telegram.
AUTHORIZED_USER_IDS=

# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to summarizer.db in the project root.
DB_PATH=
